{
  "name": "eye-clinic",
  "version": "1.0.0",
  "description": "KORENE Eye Clinic Management System - Professional Desktop Application",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite --port 5173\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development node scripts/run-electron.js\"",
    "build": "vite build",
    "build:renderer": "vite build",
    "start": "vite preview && node scripts/run-electron.js",
    "electron": "node scripts/run-electron.js",
    "electron-dev": "cross-env NODE_ENV=development node scripts/run-electron.js",
    "dist": "vite build && electron-builder --win",
    "dist:dir": "vite build && electron-builder --win dir",
    "dist:portable": "vite build && electron-builder --win portable",
    "setup-db": "node scripts/setup-database.js",
    "setup:server": "node scripts/setup-server.js",
    "start:server": "node scripts/start-server.js",
    "seed-admin": "node scripts/create-admin.js",
    "test": "jest"
  },
  "keywords": [
    "electron",
    "desktop",
    "eye-clinic",
    "medical",
    "visual-field-test",
    "korene"
  ],
  "author": "KORENE Eye Clinic",
  "license": "MIT",
  "type": "commonjs",
  "build": {
    "appId": "com.korene.eyeclinic",
    "productName": "Eye Clinic Management",
    "copyright": "Copyright © 2026 KORENE Eye Clinic",
    "asar": true,
    "compression": "normal",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/**/*",
      "database/**/*",
      "database.js",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "asarUnpack": [
      "node_modules/sqlite3/**/*",
      "node_modules/bcryptjs/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KORENE Eye Clinic",
      "license": "LICENSE.txt",
      "runAfterFinish": true,
      "displayLanguageSelector": false
    },
    "publish": null
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@electron/rebuild": "^4.0.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "babel-jest": "^30.2.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^38.1.2",
    "electron-builder": "^24.13.3",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "nodemon": "^3.1.10",
    "wait-on": "^9.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.3",
    "autoprefixer": "^10.4.21",
    "axios": "^1.13.5",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "esbuild": "^0.27.0",
    "express": "^4.18.2",
    "fs-extra": "^11.3.2",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "mssql": "^10.0.4",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.6",
    "puppeteer": "^24.22.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.4",
    "sql.js": "^1.14.1",
    "sqlite3": "^5.1.7",
    "tailwindcss": "^3.4.17",
    "uuid": "^13.0.0",
    "vite": "^7.1.7",
    "ws": "^8.14.2"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "^0.27.0"
  }
}
