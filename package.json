{
  "name": "eye-clinic",
  "version": "1.0.0",
  "description": "Visual Field Test Management System for Eye Clinics",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite --port 5173\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development node scripts/run-electron.js\"",
    "build": "vite build",
    "make": "electron-builder",
    "build-renderer": "vite build",
    "start": "vite preview && node scripts/run-electron.js",
    "electron": "node scripts/run-electron.js",
    "electron-dev": "cross-env NODE_ENV=development node scripts/run-electron.js",
    "dist": "vite build && electron-builder --publish=never",
    "dist:win": "vite build && electron-builder --win dir --publish=never",
    "setup-db": "node scripts/setup-database.js",
    "postinstall": "electron-builder install-app-deps",
    "seed-admin": "node scripts/create-admin.js",
    "test": "jest"
  },
  "keywords": [
    "electron",
    "desktop",
    "eye-clinic",
    "medical",
    "visual-field-test"
  ],
  "author": "Eye Clinic Management Team",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.eyeclinic.app",
    "productName": "KORENE",
    "directories": {
      "output": "installer-output"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/**/*",
      "database/**/*",
      "database.js",
      "package.json"
    ],
    "asarUnpack": "node_modules/**/*",
    "artifactName": "${productName}.${ext}",
    "buildDependenciesFromSource": false,
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "extraMetadata": {
      "main": "electron/main.js"
    }
  },
  "electronRebuildConfig": {
    "buildFromSource": false
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@electron/rebuild": "^4.0.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "babel-jest": "^30.2.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^38.1.2",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "electron-reload": "^2.0.0-alpha.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "nodemon": "^3.1.10",
    "wait-on": "^9.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.3",
    "autoprefixer": "^10.4.21",
    "axios": "^1.13.5",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "esbuild": "^0.27.0",
    "fs-extra": "^11.3.2",
    "jspdf": "^4.2.1",
    "mssql": "^10.0.4",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.6",
    "puppeteer": "^24.22.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.4",
    "sql.js": "^1.14.1",
    "sqlite3": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "uuid": "^13.0.0",
    "vite": "^7.1.7"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "^0.27.0"
  }
}
